# Copy to .env. Never commit credentials.
ZHIWEI_ADDR=127.0.0.1:8080
ZHIWEI_DATA_DIR=./data
ZHIWEI_WEB_DIR=./dist
ZHIWEI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
ZHIWEI_COOKIE_SECURE=false

# The base URL includes /v1, for an independently configured compatible API.
# Both model and endpoint must support image inputs.
ZHIWEI_AI_BASE_URL=
ZHIWEI_AI_MODEL=
ZHIWEI_AI_API_KEY=
ZHIWEI_AI_TIMEOUT_SECONDS=300

# Only used by `make init-admin`. Empty password generates a random password.
ZHIWEI_ADMIN_USERNAME=admin
ZHIWEI_ADMIN_DISPLAY_NAME=管理员
ZHIWEI_ADMIN_PASSWORD=

# AI text is logged only with both debug level and this explicit content switch.
ZHIWEI_LOG_LEVEL=info
ZHIWEI_LOG_FORMAT=text
ZHIWEI_LOG_AI_CONTENT=false
